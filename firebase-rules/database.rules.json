{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['uid', 'name', 'provider', 'createdAt'])"
      }
    },

    "conversations": {
      "$conversationId": {
        ".read": "auth != null && (!data.exists() || data.child('participants/0').val() === auth.uid || data.child('participants/1').val() === auth.uid)",
        ".write": "auth != null && (newData.child('participants/0').val() === auth.uid || newData.child('participants/1').val() === auth.uid)",
        ".validate": "newData.hasChildren(['id', 'participants', 'createdAt']) && newData.child('participants').hasChildren(['0', '1'])"
      }
    },

    "messages": {
      "$conversationId": {
        ".read": "auth != null && (root.child('conversations/' + $conversationId + '/participants/0').val() === auth.uid || root.child('conversations/' + $conversationId + '/participants/1').val() === auth.uid)",
        ".write": "auth != null && (root.child('conversations/' + $conversationId + '/participants/0').val() === auth.uid || root.child('conversations/' + $conversationId + '/participants/1').val() === auth.uid)",
        "$messageId": {
          ".validate": "newData.hasChildren(['conversationId', 'senderId', 'receiverId', 'text', 'createdAt']) && newData.child('senderId').val() === auth.uid"
        }
      }
    }
  }
}
